# Copy to .env for local use. Never commit the real .env file.

# development | test | production
# In production the API docs are switched off and a wildcard CORS origin is rejected.
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Origins allowed to call this API from a browser, comma separated, no trailing slash.
# Set this to the address the frontend is served from.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
